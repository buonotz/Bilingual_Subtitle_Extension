{
  "manifest_version": 3,
  "name": "Netflix Bilingual Subtitles",
  "version": "0.8.1",
  "description": "在 Netflix 网页版原字幕上方显示另一条官方字幕。",
  "permissions": ["storage", "debugger"],
  "host_permissions": ["https://www.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Netflix 双语字幕"
  },
  "background": {
    "service_worker": "background.js"
  }
}
