{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.15",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage", "debugger"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://play.max.com/*",
    "https://www.max.com/*",
    "https://max.com/*",
    "https://*.max.com/*",
    "https://www.hbomax.com/*",
    "https://*.hbomax.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://max.com/*",
        "https://*.max.com/*",
        "https://www.hbomax.com/*",
        "https://*.hbomax.com/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://max.com/*",
        "https://*.max.com/*",
        "https://www.hbomax.com/*",
        "https://*.hbomax.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "__MSG_extensionName__"
  },
  "background": {
    "service_worker": "background.js"
  }
}
